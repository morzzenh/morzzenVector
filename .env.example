# Настройки сохранения файла (документа)

MAX_FILE_SIZE_MB='20' # максимальный размер входящего файла в мегабайтах
PATH_TEMP_FILE='' # абсолютный путь к временному файлу

# Настройки базы данных для подключения

DATABASE_USER=''
DATABASE_PASSWORD=''
DATABASE_HOST=''
DATABASE_PORT=''
DATABASE_NAME=''
DRIVER_NAME=''

# Настройки модели эмбеддинга и векторизации

EMBEDDING_MODEL='nomic-embed-text:latest' # модель эмбеддинга
EMBED_DIM='768' # размер вектора
EMBED_DOC_PREFIX='search_document:' # префикс документа требуемый для модели nomic-embed-text
EMBED_QUERY_PREFIX='search_query:' # префикс поискового запроса требуемый для модели nomic-embed-text

# Настройки чанкирования текста

CHUNK_SIZE='1000' # размер чанка в символах
CHUNK_OVERLAP='200' # размер перекрытия в символах (не может быть больше CHUNK_SIZE!)
