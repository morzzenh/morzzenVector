# УЛУЧШЕНИЕ: пример конфигурации — раньше было непонятно, какие переменные вообще нужны.
# Скопируйте в .env и заполните. Сам .env в git не попадает.

# Драйвер должен быть асинхронным: postgresql+asyncpg
DRIVER_NAME=postgresql+asyncpg
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vectors

# Модель эмбеддингов в Ollama и её размерность (должны соответствовать друг другу!)
# nomic-embed-text -> 768 (английский, нужны префиксы), bge-m3 -> 1024 (мультиязычная, префиксы не нужны)
LLM_MODEL=bge-m3
EMBED_DIM=1024
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=

# Для nomic-embed-text:
# EMBED_DOC_PREFIX="search_document: "   # кавычки обязательны: иначе пробел в конце теряется
# EMBED_QUERY_PREFIX="search_query: "

# Необязательные параметры (значения по умолчанию)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# SEARCH_TOP_K=5
# SEARCH_MAX_DISTANCE=0.6
# MAX_FILE_SIZE_MB=20
