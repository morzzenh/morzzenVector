# Настройки сохранения файла (документа)

MAX_FILE_SIZE_MB='20' # максимальный размер входящего файла в мегабайтах

# Настройки базы данных для подключения

DATABASE_USER=''
DATABASE_PASSWORD=''
DATABASE_HOST=''
DATABASE_PORT=''
DATABASE_NAME=''
DRIVER_NAME='postgresql+asyncpg'

# Настройки модели эмбеддинга и векторизации

EMBEDDING_MODEL='bge-m3' # модель эмбеддинга, по умолчанию bge-m3
EMBEDDING_PORT='11434' # проброс порта приложения из контейнера Docker
EMBED_DIM='1024' # размер вектора
EMBED_DOC_PREFIX='' # префикс документа для модели эмбеддинга (напр. для nomic-embedding это 'search_document:')
EMBED_QUERY_PREFIX='' # префикс поискового запроса для модели эмбеддинга
SEARCH_MAX_DISTANCE='0.6' # порог косинусного расстояния: 0 — идентично, 1 — не связано, 2 — противоположно.
TOP_K='3' # количество чанков в выдаче

# Настройки чанкирования текста

CHUNK_SIZE='1000' # размер чанка в символах
CHUNK_OVERLAP='200' # размер перекрытия в символах (не может быть больше CHUNK_SIZE!)

# Для разработчика

ECHO='False' # тестовая настройка демонстрации SQL запросов в консоли
APP_PORT='8000' # проброс порта приложения из контейнера Docker
OLLAMA_HOST='http://ollama:11434' # хост Ollama (в Docker Container). Если локально - 'http://localhost:11434'

# Изменения параметров базы данных (требует очистки всей бд и пересоздание таблиц)

INDEX_TYPE='hnsw' # выбор метода индексирования для улучшения поиска
MAX_CONNECTIONS='16' # определяет максимальное количество двунаправленных связей, чем больше, тем точнее (от 2 до 100)
EXPLORATION_DEPTH='64' # глубина разведки при сборке графа, чем выше, тем точнее (от 1 до бесконечности)